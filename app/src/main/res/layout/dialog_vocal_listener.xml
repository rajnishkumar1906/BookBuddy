<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:cardBackgroundColor="@color/primary"
        app:cardCornerRadius="140dp"
        app:cardElevation="24dp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Gemini-style Shining Icon -->
            <ImageView
                android:id="@+id/ivVocalLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_ai_librarian_logo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvVocalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening..."
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.rajnishkumar.bookbuddy.ui.canvas.VoiceRippleView
                android:id="@+id/voiceRipple"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
