<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".ui.dashboard.MemberDashboard">

    <!-- Top Profile Bar - Shifted up by reducing paddingTop and sizes -->
    <LinearLayout
        android:id="@+id/topProfileBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:paddingTop="36dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDashProfilePic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/primary">

            <ImageView
                android:id="@+id/ivDashProfilePic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:tint="@color/gray_300"
                android:padding="6dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvDashWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Happy Reading,"
                android:textSize="11sp"
                android:textColor="@color/gray_600"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDashName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivDashAppLogo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_ai_librarian_logo" />

    </LinearLayout>

    <!-- Content Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/memberNavHost"
        android:name="com.rajnishkumar.bookbuddy.ui.dashboard.MemberHomeFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/memberBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topProfileBar"
        tools:layout="@layout/fragment_member_home" />

    <!-- Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/memberBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:itemRippleColor="#40FFFFFF"
        app:elevation="16dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/member_nav_menu" />

    <!-- Floating Vocal Search (Centered above BottomNav) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabVocalRobo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:src="@drawable/ic_ai_librarian_logo"
        app:tint="@null"
        app:backgroundTint="@android:color/white"
        app:elevation="12dp"
        app:borderWidth="2dp"
        app:strokeColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Talk to Robo" />

</androidx.constraintlayout.widget.ConstraintLayout>
